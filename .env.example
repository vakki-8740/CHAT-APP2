# ------------------------------------------------------------------
# Firebase (REQUIRED). Copy this file to ".env" and fill real values.
# Never commit ".env". These are the only values the client needs.
# ------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# ------------------------------------------------------------------
# Branding (optional placeholders — the owner fills these in later)
# ------------------------------------------------------------------
VITE_APP_NAME=Personal Chat
VITE_APP_LOGO_URL=

# ------------------------------------------------------------------
# File storage adapter for images + voice notes.
#
# provider:
#   "firestore" -> client-compressed permanent storage in Firestore (default)
#   "firebase"  -> Firebase Storage (auto-enabled when a bucket is set)
#   "http"      -> the bundled PHP backend or your own upload endpoint
#
# For backend-php/: use provider=http and leave VITE_UPLOAD_TOKEN empty.
# The frontend sends the user's Firebase ID token instead.
# ------------------------------------------------------------------
VITE_STORAGE_PROVIDER=firestore
VITE_UPLOAD_ENDPOINT=
VITE_UPLOAD_TOKEN=

# ------------------------------------------------------------------
# Voice/video calling (server-side Twilio credentials; NEVER prefix these with VITE_).
# Video calls are capped to 480p/24fps and a best-effort 500 kbps sender rate.
# The authenticated /api/turn-credentials endpoint exchanges these server-only
# Twilio API credentials for one-hour TURN credentials for the browser.
# ------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# ------------------------------------------------------------------
# Permanent Google Drive Video Pack Storage (Server-side only — never VITE_*)
# Supports videos up to 200 MB via Vercel Edge /api/video-* endpoints.
# ------------------------------------------------------------------
GDRIVE_FOLDER_ID=
GDRIVE_SCRIPT_URL=
GDRIVE_BRIDGE_SECRET=
VIDEO_SIGNING_SECRET=

