# ------------------------------------------------------------------
# Firebase (REQUIRED). Copy this file to ".env" and fill real values.
# Never commit ".env". These are the only values the client needs.
# ------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# ------------------------------------------------------------------
# Branding (optional placeholders — the owner fills these in later)
# ------------------------------------------------------------------
VITE_APP_NAME=Personal Chat
VITE_APP_LOGO_URL=

# ------------------------------------------------------------------
# File storage adapter for images + voice notes.
# Binary files are NEVER stored inside Firestore.
#
# provider:
#   "firebase" -> Firebase Storage (auto-enabled when a bucket is set)
#   "http"     -> your own upload endpoint (recommended if Storage is
#                 not available on the Firebase plan)
#   ""         -> disabled (upload buttons show a clear setup message)
# ------------------------------------------------------------------
VITE_STORAGE_PROVIDER=
VITE_UPLOAD_ENDPOINT=
VITE_UPLOAD_TOKEN=
